# 이 파일을 .env.local 로 복사한 뒤 값을 채운다. (Vercel에서는 Project Settings → Environment Variables)
# Neon 풀링 연결 문자열 — Vercel ↔ Neon 통합 시 자동 주입. 로컬에서 비우면 PGlite 데모 DB 사용
DATABASE_URL=
# 마이그레이션용 직접 연결 — 자동 주입
DATABASE_URL_UNPOOLED=
# KIPRIS Plus 인증키
KIPRIS_PLUS_API_KEY=
# Claude API
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Cron 요청 검증 (16자 이상 무작위 문자열)
CRON_SECRET=
# 시연용 로그인 비밀번호
APP_PASSWORD=
# 세션 쿠키 서명
SESSION_SECRET=
# 알림(선택)
NOTIFY_SLACK_WEBHOOK=
